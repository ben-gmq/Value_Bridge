# Copy to .env and fill in. Never commit .env. Key names only here — never values.
DATABASE_URL=
MIGRATION_DATABASE_URL=
JWT_SECRET_KEY=
FRONTEND_URL=http://localhost:5180
ALLOWED_EMAIL_DOMAINS=
# Tests only (scripts/bootstrap_local_db.sh creates both databases)
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
# Local only. Never true in Azure — use `python -m seeds.create_admin` there (H1).
ALLOW_FIRST_RUN_SETUP=false
ENABLE_API_DOCS=false
